/build/
/dist/
*.apk
*.tar.gz

# Локальная сборка в SDK: артефакты и вспомогательный скрипт.
# Воспроизводимая сборка описана в .github/workflows/release.yml.
.build-out/

# Локальные настройки инструментов и рабочее пространство агентов: настройки
# конкретной машины и промежуточные отчёты, которым не место в истории.
.claude/
.superpowers/

# Пользовательская документация живёт в корне репозитория и отслеживается:
# README.md. Если сюда добавится ещё один пользовательский документ, его место
# тоже в корне — иначе он молча выпадет из репозитория, а ссылка на него из
# README окажется битой.

# Мусор редакторов и файловых менеджеров.
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Скачанные списки домены и локальные временные файлы, если кто-то
# запустит генераторы прямо в дереве репозитория.
/lists/
*.tsv.tmp
*.log

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
