#!/bin/sh
# Restores the route attachment when the client recreates its tun device.
# This happens on the ordinary path: procd restarts the fallen client, the
# client makes the device anew, and the default route in table 880
# disappears together with the old device — deleting an interface takes all
# routes referencing it away.
#
# Without this script, after every client restart marked traffic would stay
# in the blackhole until a manual service restart: the tunnel works, but
# traffic does not enter it.

[ "$ACTION" = "add" ] || exit 0

dev="${INTERFACE:-$DEVICENAME}"
[ -n "$dev" ] || exit 0

# Only tun devices: the marker is the presence of tun_flags in sysfs.
[ -e "/sys/class/net/$dev/tun_flags" ] || exit 0

# And only NON-persistent ones: the IFF_PERSIST bit (0x0800) is set on
# devices created manually via `ip tuntap add`, while the client creates
# its own without it. The check filters out foreign persistent interfaces,
# including the tt0 left on routers by former package versions.
flags=$(cat "/sys/class/net/$dev/tun_flags" 2>/dev/null) || exit 0
# Arithmetic, not character-position parsing: busybox ash understands
# hexadecimal literals (verified on a router — 0x1801 & 0x800 = 2048,
# 0x1001 & 0x800 = 0), while a positional comparison would break on any
# other width of the value.
[ "$(( flags & 0x800 ))" = "0" ] || exit 0

RECORDS=/var/etc/trusttunnel/settings.tsv
OUTDIR=/var/etc/trusttunnel
[ -f "$RECORDS" ] || exit 0

# The service must be considered running: otherwise there is nothing and no
# reason to attach.
/etc/init.d/trusttunnel running >/dev/null 2>&1 || exit 0

# If already attached to a live device — leave it alone. This way an event
# from a foreign interface cannot switch us off a working tunnel.
cur=$(cat "$OUTDIR/device" 2>/dev/null)
if [ -n "$cur" ] && [ -d "/sys/class/net/$cur" ] && [ "$cur" != "$dev" ]; then
	exit 0
fi

/usr/libexec/trusttunnel/routing attach "$RECORDS" "$OUTDIR" "$dev" \
	&& logger -t trusttunnel "hotplug: reattached routing to $dev"
