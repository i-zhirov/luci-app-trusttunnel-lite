msgid "Drop traffic when the tunnel is down"
msgstr "Отбрасывать трафик при упавшем туннеле"

msgid "Adds a blackhole route so marked traffic is dropped instead of leaking to the provider."
msgstr "Добавляет блэкхол-маршрут, чтобы помеченный трафик отбрасывался, а не уходил к провайдеру."

msgid "Route the router's own traffic too"
msgstr "Маршрутизировать также трафик самого роутера"

msgid "Firewall mark"
msgstr "Метка фаервола"

msgid "Enter a decimal number or 0x-prefixed hexadecimal"
msgstr "Введите десятичное число или шестнадцатеричное с префиксом 0x"

msgid "Routing table"
msgstr "Таблица маршрутизации"

msgid "Any table id except 0 and the reserved 253-255."
msgstr "Любой номер таблицы, кроме 0 и зарезервированных 253-255."

msgid "Enter a table id between 1 and 4294967294"
msgstr "Введите номер таблицы от 1 до 4294967294"

msgid "Table ids 253, 254 and 255 are reserved by the system"
msgstr "Номера 253, 254 и 255 зарезервированы системой"

msgid "Do not bypass these"
msgstr "Не обходить"

msgid "Not a valid domain, IP address or CIDR range"
msgstr "Некорректный домен, IP-адрес или CIDR-диапазон"

msgid "Enter a decimal number no greater than 4294967295"
msgstr "Введите десятичное число не больше 4294967295"

