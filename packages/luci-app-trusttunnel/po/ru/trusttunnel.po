msgstr "Сетевые настройки"

msgid "MTU"
msgstr "MTU"

msgid "Drop traffic when the tunnel is down"
msgstr "Отбрасывать трафик, когда туннель не работает"

msgid "Adds a blackhole route so marked traffic is dropped instead of leaking to the provider."
msgstr "Добавляет маршрут в «чёрную дыру», чтобы помеченный трафик отбрасывался, а не утекал к провайдеру."

msgid "Route the router's own traffic too"
msgstr "Маршрутизировать также трафик самого маршрутизатора"

msgid "Firewall mark"
msgstr "Метка firewall"

msgid "Enter a decimal number or 0x-prefixed hexadecimal"
msgstr "Укажите десятичное число или шестнадцатеричное с префиксом 0x"

msgid "Routing table"
msgstr "Таблица маршрутов"

msgid "Any table id except 0 and the reserved 253-255."
msgstr "Любой идентификатор таблицы, кроме 0 и зарезервированных 253–255."

msgid "Enter a table id between 1 and 4294967294"
msgstr "Введите идентификатор таблицы от 1 до 4294967294"

msgid "Table ids 253, 254 and 255 are reserved by the system"
msgstr "Идентификаторы таблиц 253, 254 и 255 зарезервированы системой"

msgid "Not a valid domain, IP address or CIDR range"
msgstr "Недопустимый домен, IP-адрес или диапазон CIDR"

msgid "Enter a decimal number no greater than 4294967295"
msgstr "Десятичное число должно быть не больше 4294967295"

msgid "Versions"
msgstr "Информация о версиях"

msgid "Package"
msgstr "Версия пакета"

msgid "TrustTunnel client"
msgstr "Клиентская программа TrustTunnel"

