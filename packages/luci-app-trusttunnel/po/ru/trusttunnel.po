msgstr "версия актуальна"

msgid "unavailable — no network and no cached result"
msgstr "недоступно — нет сети и нет кэшированного результата"

msgid "GitHub unreachable, showing the last cached result"
msgstr "GitHub недоступен, показан последний кэшированный результат"

msgid "the installed version is newer than the latest release (%s)"
msgstr "установленная версия новее последнего выпуска (%s)"

msgid "Check now"
msgstr "Проверить обновления"

msgid "Diagnostics"
msgstr "Проверка состояния"

msgid "Running checks — this takes a few seconds…"
msgstr "Выполняется проверка — это займёт несколько секунд…"

msgid "checks passed: %d, remarks: %d, problems: %d, skipped: %d"
msgstr "проверок пройдено: %d, с замечаниями: %d, ошибок: %d, не выполнено: %d"

msgid "everything checks out"
msgstr "все проверки пройдены"

msgid "works, with remarks"
msgstr "работает, с замечаниями"

msgid "there are problems"
msgstr "обнаружены ошибки"

msgid "not checked"
msgstr "не проверено"

msgid "Configuration"
msgstr "Конфигурация"

msgid "Prerequisites"
msgstr "Предварительные требования"

msgid "Kernel state"
msgstr "Проверки ядра"

