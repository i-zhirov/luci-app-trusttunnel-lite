#!/bin/sh
# Generates client.toml for trusttunnel_client from the records
# configuration.
# Usage: gen-config <records-file> [pem-file]
set -u

TT_LIBDIR="${TT_LIBDIR:-$(dirname "$0")}"
# The path is computed at run time; a static linter cannot resolve it.
# shellcheck disable=SC1091
. "$TT_LIBDIR/records.sh"

# TT_RECORDS is read by the sourced records.sh via tt_get/tt_list — the
# linter cannot see that connection because it does not follow sourcing.
# shellcheck disable=SC2034
TT_RECORDS="${1:?usage: gen-config <records-file> [pem-file]}"
CERT_FILE="${2:-}"

die() { printf 'gen-config: %s\n' "$1" >&2; exit 1; }

# Escaping for a basic TOML string: backslash and double quote.
esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

# Prints a TOML array of strings from values on stdin, one per line.
array_from_stdin() {
	awk '
		{
			gsub(/\\/, "\\\\")
			gsub(/"/, "\\\"")
			items[n++] = "\"" $0 "\""
		}
		END {
			out = ""
			for (i = 0; i < n; i++) out = out (i ? ", " : "") items[i]
			printf "[%s]", out
		}
	'
}

hostname=$(tt_get endpoint.hostname)
username=$(tt_get endpoint.username)
password=$(tt_get endpoint.password)
[ -n "$hostname" ] || die "endpoint.hostname is not set"
[ -n "$username" ] || die "endpoint.username is not set"
[ -n "$password" ] || die "endpoint.password is not set"
[ "$(tt_count endpoint.address)" != "0" ] || die "endpoint.address is not set"

mtu=$(tt_get network.mtu 1350)
loglevel=$(tt_get main.log_level info)
protocol=$(tt_get endpoint.protocol http2)

# The PEM is emitted as a literal multi-line TOML string: PEM cannot
# contain apostrophes, so no escaping is needed. `awk 1` normalizes the
# file, adding a trailing newline if absent — otherwise the closing
# apostrophes would stick to the certificate's last line.
emit_certificate() {
	if [ -n "$CERT_FILE" ] && [ -s "$CERT_FILE" ]; then
		printf "certificate = '''\n"
		awk 1 "$CERT_FILE"
		printf "'''"
	else
		printf 'certificate = ""'
	fi
}

addresses=$(tt_list endpoint.address | array_from_stdin)
dns_upstreams=$(tt_list endpoint.dns_upstream | array_from_stdin)

# exclusions = "do not bypass": domains/addresses the client keeps direct
# (domains.direct). The fork has no additional sources.
exclusions=$(tt_list domains.direct | array_from_stdin)

# [listener.tun] has NO device_name and use_existing keys — they used to be
# generated here, and that was a mistake. Verified against the reference
# config that setup_wizard itself produces: the schema knows bound_if (the
# interface for the client's OUTGOING connections, a different purpose),
# included_routes, excluded_routes, mtu_size and change_system_dns. The
# client silently ignored the invented keys and always created ITS OWN
# device, while the one we created stayed without a carrier: the route in
# table 880 pointed into a dead interface, marked traffic was dropped, and
# check_domain kept answering "verdict: tunnel" all the while. Now the
# client creates the device and the route is attached to it after start
# (routing attach).
#
# included_routes and excluded_routes are left EMPTY deliberately: we own
# the routing — via the mark and table 880. Handing it to the client would
# mean losing the blackhole killswitch route and the single point of route
# management.
cat <<TOML
# Generated by luci-app-trusttunnel-lite. Do not edit: changes are overwritten.
loglevel = "$(esc "$loglevel")"
vpn_mode = "general"
killswitch_enabled = false
post_quantum_group_enabled = $(tt_bool endpoint.post_quantum 1)
exclusions_tcp_early_ack_enabled = true
exclusions_preresolve_enabled = true
exclusions = ${exclusions}

[endpoint]
hostname = "$(esc "$hostname")"
addresses = ${addresses}
has_ipv6 = $(tt_bool endpoint.has_ipv6 1)
username = "$(esc "$username")"
password = "$(esc "$password")"
skip_verification = $(tt_bool endpoint.skip_verification 0)
$(emit_certificate)
upstream_protocol = "$(esc "$protocol")"
anti_dpi = $(tt_bool endpoint.anti_dpi 0)
dns_upstreams = ${dns_upstreams}

[listener.tun]
included_routes = []
excluded_routes = []
mtu_size = ${mtu}
change_system_dns = false
TOML
