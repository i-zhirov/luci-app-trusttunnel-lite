#!/bin/sh
# Creates the firewall zone for the client's tun device.
# Idempotent: a repeated run duplicates nothing.

# OpenWrt library, absent on the linter's machine.
# shellcheck disable=SC1091
. /lib/functions.sh

zone_exists=""
# A variable with the `_` prefix rather than `local`: `local` is not in
# POSIX, and `shellcheck -s sh` reports it (SC3043) with a non-zero exit
# code, failing CI on the very first push. The rest of our scripts use
# `_`-variables for the same reason, so this is consistent too.
# Called via config_foreach, and _zname is assigned by config_get from the
# OpenWrt library — neither is visible to the linter statically.
# shellcheck disable=SC2329,SC2317,SC2154
find_zone() {
	config_get _zname "$1" name
	[ "$_zname" = "trusttunnel" ] && zone_exists=1
}
config_load firewall
config_foreach find_zone zone

# Collapsing duplicate zones. An early version of this script read the zone
# name with an EMPTY section argument (`config_get _zname "" name` instead
# of `"$1"`), so zone_exists was never set and the creation block fired on
# EVERY install. On a live router three identical trusttunnel zones and
# three forwarding rules piled up — each generates `define
# trusttunnel_devices`, fw4 failed with "redefinition of symbol", and the
# whole firewall did not come up: the network lost LAN-to-WAN forwarding,
# and only the list domains worked, because OUR zone masquerades them in
# its own table.
#
# Keep the first trusttunnel zone and the first forwarding to it, delete the
# rest. Runs before creation so duplicates are not mistaken for a missing
# zone.
_seen_zone=0
# config_foreach + config_get, invisible to the linter.
# shellcheck disable=SC2329,SC2317,SC2154
dedup_zone() {
	config_get _n "$1" name
	[ "$_n" = "trusttunnel" ] || return 0
	if [ "$_seen_zone" = "1" ]; then
		uci delete "firewall.$1"
		zone_deduped=1
	else
		_seen_zone=1
	fi
}
_seen_fwd=0
# shellcheck disable=SC2329,SC2317,SC2154
dedup_fwd() {
	config_get _d "$1" dest
	[ "$_d" = "trusttunnel" ] || return 0
	if [ "$_seen_fwd" = "1" ]; then
		uci delete "firewall.$1"
		zone_deduped=1
	else
		_seen_fwd=1
	fi
}
zone_deduped=""
config_foreach dedup_zone zone
config_foreach dedup_fwd forwarding
if [ -n "$zone_deduped" ]; then
	uci commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1
	logger -t trusttunnel "removed duplicate firewall zones left by an earlier version"
fi

if [ -z "$zone_exists" ]; then
	z=$(uci add firewall zone)
	uci set firewall."$z".name='trusttunnel'
	uci set firewall."$z".input='REJECT'
	uci set firewall."$z".output='ACCEPT'
	uci set firewall."$z".forward='REJECT'
	uci set firewall."$z".masq='1'
	uci set firewall."$z".mtu_fix='1'
	# A pattern, not a concrete name: the device is created by the CLIENT,
	# which picks the name itself (tun0, then increasing); no setting
	# governs it. A zone bound to our former tt0 would not cover the
	# client's device at all — forwarding into the tunnel would be dropped
	# by the firewall. The `tun+` syntax is the common convention for
	# OpenWrt zones: OpenVPN configurations are laid out the same way.
	#
	# The side effect is deliberate: the zone will also cover foreign tun
	# devices if another VPN runs on the router. The alternative — rewriting
	# the zone on every service start and reloading the firewall — is more
	# expensive and more visible.
	uci add_list firewall."$z".device='tun+'

	f=$(uci add firewall forwarding)
	uci set firewall."$f".src='lan'
	uci set firewall."$f".dest='trusttunnel'

	uci commit firewall
	# Without a reload the zone and the forwarding rule exist only in UCI:
	# tt0 belongs to no zone until the next reboot, forwarding into the
	# tunnel is dropped, and the status page meanwhile shows the device,
	# the rule, the table and nft as healthy — green on broken right after
	# installation.
	/etc/init.d/firewall reload >/dev/null 2>&1
fi

# Migration for already-installed routers. A zone created by a former
# version is bound to the tt0 device, which we no longer create: the device
# now belongs to the client and is named differently. Without this fix the
# zone covers no live interface after an update, forwarding into the tunnel
# is dropped by the firewall, and the status page shows the device, the
# rule, the table and nft as healthy — the very "green on broken" we have
# been eliminating throughout the project.
#
# The block above will not fire: it runs only when no zone exists yet.
# Same case: called via config_foreach, assigned via config_get.
# shellcheck disable=SC2329,SC2317,SC2154
migrate_zone_device() {
	config_get _zn "$1" name
	[ "$_zn" = "trusttunnel" ] || return 0
	_devs=$(uci -q get "firewall.$1.device" 2>/dev/null)
	case " $_devs " in
		*" tun+ "*) return 0 ;;
	esac
	uci -q delete "firewall.$1.device"
	uci add_list "firewall.$1.device"='tun+'
	zone_migrated=1
}

if [ -n "$zone_exists" ]; then
	zone_migrated=""
	config_foreach migrate_zone_device zone
	if [ -n "$zone_migrated" ]; then
		uci commit firewall
		/etc/init.d/firewall reload >/dev/null 2>&1
		logger -t trusttunnel "firewall zone migrated from tt0 to the tun+ wildcard"
	fi
fi

# The update check cache is reset on EVERY package install: it stores the
# "latest release on GitHub", and after an update it certainly holds an
# answer obtained before the installed version was released. Otherwise the
# status page compares a fresh package with a stale answer and concludes
# "up to date". This costs exactly one GitHub request on the first page
# open.
mkdir -p /var/cache/trusttunnel
rm -f /var/cache/trusttunnel/release.json


# Registering the init script in the boot sequence. WITHOUT THIS the tunnel
# does not come up after a router reboot at all: verified on live hardware —
# after a reboot there was no link in /etc/rc.d/, not a single log line, the
# service did not start.
#
# Two different "enabled"s are easy to confuse, and the defect rode exactly
# on that: the "Enable" checkbox in the UI sets trusttunnel.main.enabled,
# which is only a check INSIDE start_service. Auto-start is the rc.d link's
# job, and nobody created it.
#
# The script is registered ALWAYS, regardless of main.enabled: start_service
# itself exits at the beginning when the flag is off and logs that. Thus the
# single decision ("whether to start") stays in one place instead of being
# spread across two mechanisms with different semantics.
/etc/init.d/trusttunnel enable >/dev/null 2>&1

rm -f /tmp/luci-indexcache /tmp/luci-modulecache/* 2>/dev/null
exit 0
