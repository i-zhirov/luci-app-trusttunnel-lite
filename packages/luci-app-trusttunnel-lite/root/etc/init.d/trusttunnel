#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

LIBDIR=/usr/libexec/trusttunnel
OUTDIR=/var/etc/trusttunnel
RECORDS=$OUTDIR/settings.tsv
CLIENT=/opt/trusttunnel_client/trusttunnel_client

# The client is statically linked against BoringSSL and takes its trust
# store from SSL_CERT_FILE. Vanilla OpenWrt without ca-bundle has none.
setup_trust_store() {
	# No trust store is needed in two cases: certificate verification is
	# disabled, or the endpoint certificate is pinned in the configuration.
	# The error message used to promise both ways out, but the code
	# implemented neither, so a router without ca-bundle could not connect
	# even to a server with a pinned self-signed certificate — the
	# skip_verification option did not work at all.
	config_load trusttunnel
	config_get_bool _skipver endpoint skip_verification 0
	config_get _pinned endpoint certificate
	if [ "$_skipver" = "1" ] || [ -n "$_pinned" ]; then
		return 0
	fi
	for f in /etc/ssl/cert.pem /etc/ssl/certs/ca-certificates.crt; do
		if [ -s "$f" ]; then
			export SSL_CERT_FILE="$f"
			[ -d /etc/ssl/certs ] && export SSL_CERT_DIR=/etc/ssl/certs
			return 0
		fi
	done
	logger -t trusttunnel "error: no CA bundle found; install ca-bundle, pin a certificate, or disable verification"
	return 1
}

# Certificates are validated against the system clock: before NTP sync any
# certificate looks not yet valid.
wait_for_time() {
	floor=$(date -r "$LIBDIR/gen-config" +%s 2>/dev/null) || floor=1750000000
	waited=0
	while [ "$(date +%s)" -lt "$floor" ] && [ "$waited" -lt 30 ]; do
		sleep 2
		waited=$((waited + 2))
	done
	# A silent timeout exit would make the failure undiagnosable: the client
	# would reject the certificate as "not yet valid", and the log would
	# contain nothing pointing at the clock.
	if [ "$(date +%s)" -lt "$floor" ]; then
		logger -t trusttunnel "warning: clock still behind install time; certificate validation may fail"
	fi
}

wait_for_wan() {
	waited=0
	while [ "$waited" -lt 30 ]; do
		[ -n "$(ip route show default 2>/dev/null)" ] && return 0
		sleep 1
		waited=$((waited + 1))
	done
	logger -t trusttunnel "warning: no default route after 30s"
	return 0
}

regenerate() {
	# Permissions are set via umask, not chmod after creation: otherwise a
	# window remains between file creation and chmod in which the endpoint
	# password and the private certificate are world-readable.
	umask 077
	mkdir -p "$OUTDIR"
	# Write to a temporary file and move over on success: `>` truncates the
	# target immediately, and a failure mid-write (uci-export crashed, disk
	# full) would destroy the applied-state record that stop_service later
	# uses to tear down routing — there would be nothing left to tear down.
	"$LIBDIR/uci-export" > "$RECORDS.new" || { rm -f "$RECORDS.new"; return 1; }
	mv "$RECORDS.new" "$RECORDS"

	# The certificate bypasses records (multi-line PEM) and is passed as a
	# file.
	cert=""
	cert_value=$(uci -q get trusttunnel.endpoint.certificate 2>/dev/null)
	if [ -n "$cert_value" ]; then
		printf '%s\n' "$cert_value" > "$OUTDIR/endpoint.pem"
		chmod 600 "$OUTDIR/endpoint.pem"
		cert="$OUTDIR/endpoint.pem"
	else
		rm -f "$OUTDIR/endpoint.pem"
	fi

	"$LIBDIR/gen-config" "$RECORDS" "$cert" > "$OUTDIR/client.toml" || return 1
	chmod 600 "$OUTDIR/client.toml"
	return 0
}

# Rolls back the restart() optimization when start_service could not finish.
# The "no teardown needed" decision relied on start bringing everything back
# up; if it did not get there, the service is off while the table, the mark
# rule and the blackhole would keep pointing at a tunnel that does not exist.
# Marked traffic would fall into the blackhole with the bypass disabled —
# from the outside that looks like "the internet is gone", and connecting it
# to a failed settings apply is impossible.
abort_restart_cleanup() {
	if [ "${_TT_KEEP_ROUTING:-0}" = "1" ]; then
		_TT_KEEP_ROUTING=0
		[ -f "$OUTDIR/settings.tsv" ] && "$LIBDIR/routing" down "$OUTDIR/settings.tsv"
	fi
}


# The largest ifindex among all interfaces. ifindex grows monotonically, so
# it reliably means "appeared AFTER this moment", unlike a name.
max_ifindex() {
	_max=0
	for _n in /sys/class/net/*; do
		_i=$(cat "$_n/ifindex" 2>/dev/null) || continue
		[ "$_i" -gt "$_max" ] 2>/dev/null && _max="$_i"
	done
	printf '%s\n' "$_max"
}

# Prints NON-persistent tun devices with an ifindex above the given one.
# The tun marker is the presence of /sys/class/net/<dev>/tun_flags (verified
# on a live router: tt0 and tun0 have it, br-lan does not). The IFF_PERSIST
# bit (0x800) filters out devices created manually via `ip tuntap add`: the
# client creates its own without it.
new_client_devices() {
	_since="$1"
	for _n in /sys/class/net/*; do
		[ -e "$_n/tun_flags" ] || continue
		_i=$(cat "$_n/ifindex" 2>/dev/null) || continue
		[ "$_i" -gt "$_since" ] 2>/dev/null || continue
		_f=$(cat "$_n/tun_flags" 2>/dev/null) || continue
		[ "$(( _f & 0x800 ))" = "0" ] || continue
		printf '%s\n' "${_n##*/}"
	done
}

# Waits for a NEW tun device to appear and attaches the route to it.
# $1 — path to the list snapshot taken BEFORE the client was started.
#
# The client picks its own device name, not governed by any setting, so the
# only reliable way to learn it is comparing the list before and after.
# Guessing by name is out: tun0 may already belong to another VPN on the same
# router, and we would point tunnel traffic into a foreign interface.
#
# The wait is capped at 30 seconds. The client raises the device within
# fractions of a second after a successful connection, but the connection may
# fail — no network, wrong address, server refusal. An endless wait would
# hang start_service, while no wait at all would mean the route never gets
# installed. Until the device exists, marked traffic is held by the blackhole
# installed in do_up — a failure here does not open a leak, it keeps the
# killswitch engaged. A SINGLE attach attempt, no waiting.
#
# There USED to be a 30-second wait loop here, and it could never work: procd
# starts the instance process only AFTER start_service returns, so inside
# start_service the client does not exist yet and nobody can create the
# device. Measured on a live router: `/etc/init.d/trusttunnel start` took
# 31 seconds, every start wrote a bogus "the client did not create the
# device" warning to the log, and the actual attach was done by the hotplug
# script.
#
# The main mechanism is /etc/hotplug.d/net/40-trusttunnel: it fires exactly
# when the device appears and covers both the first start and the device
# recreation after a procd-driven client restart.
#
# This attempt is for the edge case where a suitable device ALREADY exists
# and no add event will come: e.g. the service restarts over a still-running
# client. It costs one sysfs check.
attach_client_device() {
	_new=$(new_client_devices "$1" | head -n1)
	[ -n "$_new" ] || return 0
	"$LIBDIR/routing" attach "$RECORDS" "$OUTDIR" "$_new"
}

start_service() {
	config_load trusttunnel
	config_get_bool enabled main enabled 0
	[ "$enabled" = "1" ] || {
		logger -t trusttunnel "disabled in configuration, not starting"
		abort_restart_cleanup
		return 0
	}

	[ -x "$CLIENT" ] || {
		logger -t trusttunnel "error: $CLIENT not found; run install.sh"
		abort_restart_cleanup
		return 1
	}

	setup_trust_store || { abort_restart_cleanup; return 1; }
	regenerate || {
		logger -t trusttunnel "error: configuration generation failed"
		abort_restart_cleanup
		return 1
	}

	wait_for_wan
	wait_for_time

	"$LIBDIR/routing" up "$RECORDS" "$OUTDIR" || {
		logger -t trusttunnel "error: routing setup failed"
		abort_restart_cleanup
		return 1
	}

	# Snapshot of tun devices STRICTLY before the client starts: the
	# difference against the post-start list is what yields the name of the
	# device the client created.
	# Marking by ifindex STRICTLY before the client starts. Name comparison
	# does not work here: at snapshot time the previous client's device has
	# not disappeared yet — procd kills the process asynchronously and the
	# device goes away with it — so no "new name" appeared and the wait fell
	# over on timeout. Verified on a live router from the log: the timeout
	# warning and the successful hotplug attach arrived one second apart.
	# ifindex grows monotonically, so a recreated device is distinguishable
	# even under the same name.
	_tun_since=$(max_ifindex)

	procd_open_instance trusttunnel
	procd_set_param command "$CLIENT" -c "$OUTDIR/client.toml"
	# Environment variables are passed only when the trust store is actually
	# defined. With a pinned certificate or disabled verification
	# setup_trust_store returns early, and an empty SSL_CERT_FILE would
	# confuse BoringSSL instead of simply being absent.
	if [ -n "$SSL_CERT_FILE" ]; then
		# SSL_CERT_DIR is passed ONLY when non-empty — the same risk the
		# neighboring comment describes for SSL_CERT_FILE: an empty env var
		# is not the same for BoringSSL as a missing one and may break the
		# trust store lookup instead of simply not participating in it.
		if [ -n "${SSL_CERT_DIR:-}" ]; then
			procd_set_param env SSL_CERT_FILE="$SSL_CERT_FILE" SSL_CERT_DIR="$SSL_CERT_DIR"
		else
			procd_set_param env SSL_CERT_FILE="$SSL_CERT_FILE"
		fi
	fi
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/trusttunnel.pid
	procd_close_instance

	# Attaching to the client's device is the hotplug script's job: procd
	# starts the process only AFTER we return from here, so waiting for the
	# device here is pointless (see the comment at attach_client_device).
	# This call only covers the already-existing-device case and does not
	# wait.
	attach_client_device "$_tun_since" || true
}

stop_service() {
	# Routing is torn down ALWAYS except one case: apply_settings has already
	# compared the settings and knows that neither the table id nor the mark
	# changed, so the rules start_service will load again are the same.
	# Taking them down between stop and start is pointless: while the client
	# comes up, marked traffic must hit the blackhole rather than leak
	# straight past the tunnel — and that leak is exactly what used to
	# happen, because without the table there is nothing to mark with.
	#
	# The flag is deliberately NOT set by default: a manual restart, an
	# interface trigger and any other invocation behave exactly as before.
	# The cheap path is taken only where the settings' unchangedness is
	# proven.
	if [ "${_TT_KEEP_ROUTING:-0}" != "1" ]; then
		[ -f "$OUTDIR/settings.tsv" ] && "$LIBDIR/routing" down "$OUTDIR/settings.tsv"
	fi
	return 0
}

# Unique keys that distinguish two records files.
#
# Counts line OCCURRENCES rather than comparing sets: list options are
# exported into records with a repeated key (several "domains.direct" lines),
# and a set comparison would miss adding a second value to an existing key —
# a checked or unchecked box would not be applied.
#
# awk, not comm: comm requires sorted input and is not present in all busybox
# builds, while awk always is and needs a single pass over each file.
changed_keys() {
	awk -F'\t' '
		FILENAME == ARGV[1] { seen[$0]++; next }
		{ seen[$0]-- }
		END {
			for (l in seen) if (seen[l] != 0) {
				split(l, p, "\t")
				out[p[1]] = 1
			}
			for (k in out) print k
		}
	' "$1" "$2" | sort -u
}

# The minimal action a single key change requires.
# $1 — the key.
#
# Classes in ascending cost:
#   noop         — nothing to apply
#   reload       — regenerate and apply to the kernel, leave the client alone
#   restart      — restart the client, keep the routing
#   restart_full — restart the client and tear the routing down completely
#
# The enumeration is EXPLICIT and acts as a whitelist: anything unknown gets
# restart_full, i.e. exactly the behavior that predates this classification.
# An error toward the "more expensive" side costs one extra restart; an error
# toward the "cheaper" side means a silently unapplied setting — the UI shows
# the new value while the old one works, and there is nothing to diagnose
# with. Completeness against the uci-export schema is checked by a test.
change_class() {
	case "$1" in
		# domains.direct goes into client.toml (client exclusions), which
		# the client reads once at startup.
		domains.direct)
			printf 'restart\n' ;;
		# Everything the nft table and the mark rule are built from.
		network.lan_devices|network.blackhole_on_down|\
		network.include_router_traffic)
			printf 'reload\n' ;;
		# The table id and the mark are the only values that TEAR DOWN the
		# routing. Keeping the old and raising the new would leave the old
		# table and the old rule hanging forever.
		network.table|network.fwmark)
			printf 'restart_full\n' ;;
		# Disabling the service must tear the routing down: otherwise marked
		# traffic would keep falling into the blackhole with the bypass off.
		main.enabled)
			printf 'restart_full\n' ;;
		# The rest goes into client.toml, which the client reads once at
		# startup. endpoint.* is listed as a pattern deliberately: this
		# section has no value that does not end up in the client config
		# and never will.
		main.log_level|network.mtu|endpoint.*)
			printf 'restart\n' ;;
		*)
			printf 'restart_full\n' ;;
	esac
}

class_rank() {
	case "$1" in
		noop) printf '0\n' ;;
		reload) printf '1\n' ;;
		restart) printf '2\n' ;;
		*) printf '3\n' ;;
	esac
}

# The more expensive of two classes.
class_max() {
	if [ "$(class_rank "$1")" -ge "$(class_rank "$2")" ]; then
		printf '%s\n' "$1"
	else
		printf '%s\n' "$2"
	fi
}

# The action a transition from one records state to another requires: the
# maximum over all changed keys. Maximum, not first or last — a cheap edit
# next to an expensive one must not cheapen it.
classify_change() {
	_best=noop
	for _k in $(changed_keys "$1" "$2"); do
		_best=$(class_max "$_best" "$(change_class "$_k")")
	done
	printf '%s\n' "$_best"
}

# Overrides the generic restart() from /etc/rc.common (stop; start). Between
# stop and start the routing is rebuilt from scratch — unless apply_settings
# preserved it via _TT_KEEP_ROUTING.
restart() {
	# trap '' TERM — as in the generic restart() from /etc/rc.common: this
	# process is often run detached (interface trigger, cron, Save & Apply),
	# and a TERM received mid stop+start must not abort the routing and
	# client restoration halfway.
	trap '' TERM
	stop "$@"
	start "$@"
}

# Applies changed settings with the minimal action that actually applies
# them.
#
# WHY. There used to be an unconditional restart here, and any edit — even a
# single line in domains.direct — killed the client: the tunnel dropped for
# several seconds. Along with it the nft table disappeared between stop and
# start, so marked LAN traffic had time to go STRAIGHT — a plain settings
# save opened exactly the leak this package protects against. Meanwhile the
# client reads client.toml once at startup, and an edit that never reaches
# client.toml has nothing to do with restarting it.
#
# The decision is made from a diff of the applied-state record against what
# UCI exports right now; change_class classifies the keys. Any failure along
# the way rolls back to a full restart: the kernel rules are in an unknown
# state at that point, and leaving everything as is would mean showing a
# running service on top of an underloaded table.
apply_settings() {
	# Nothing to compare against — this is a plain start, not an apply on
	# top of a known state. /var on OpenWrt is tmpfs, so after a reboot the
	# record does not exist at all. Same for a stopped service.
	if [ ! -f "$RECORDS" ] || ! running >/dev/null 2>&1; then
		restart
		return $?
	fi

	# The same umask as in regenerate: the endpoint password lands in
	# records, and creating the file under the system umask would leave it
	# world-readable — exactly the exposure regenerate already closed.
	umask 077
	mkdir -p "$OUTDIR"
	if ! "$LIBDIR/uci-export" > "$RECORDS.next"; then
		# The file is removed on this path too: even half-written it may
		# contain the password.
		rm -f "$RECORDS.next"
		logger -t trusttunnel "warning: settings export failed, applying the long way"
		restart
		return $?
	fi

	_class=$(classify_change "$RECORDS" "$RECORDS.next")

	# The certificate is the only schema value absent from records: the PEM
	# is multi-line and a record value cannot contain a newline. It is
	# compared against the file regenerate wrote at the last apply; without
	# this check a certificate change or removal would never be applied,
	# because records do not change on it.
	_cert_now=$(uci -q get trusttunnel.endpoint.certificate 2>/dev/null)
	_cert_was=""
	[ -f "$OUTDIR/endpoint.pem" ] && _cert_was=$(cat "$OUTDIR/endpoint.pem" 2>/dev/null)
	if [ "$_cert_now" != "$_cert_was" ]; then
		_class=$(class_max "$_class" restart)
	fi

		case "$_class" in
		noop)
			# The record is updated here as well. Otherwise the changed key
			# would keep differing from the applied state and participate in
			# EVERY subsequent comparison — one schedule edit would make
			# all further applies expensive forever.
			mv "$RECORDS.next" "$RECORDS"
			logger -t trusttunnel "settings applied: nothing to do for these keys"
			;;
		reload)
			# No own snapshot needed here: regenerate exports UCI itself
			# and moves the record over on success itself.
			rm -f "$RECORDS.next"
			if regenerate && "$LIBDIR/routing" up "$RECORDS" "$OUTDIR"; then
				# reattach HERE specifically, not hoping for hotplug: no
				# add event will come — the client's device never went
				# away. The route itself usually survives because do_up
				# does a route replace rather than a flush, but relying
				# on that silently is not worth it: the call is
				# idempotent and costs one command.
				"$LIBDIR/routing" reattach "$RECORDS" "$OUTDIR"
				logger -t trusttunnel "settings applied without restarting the client"
			else
				logger -t trusttunnel "warning: applying without a restart failed, restarting the service"
				restart
				return $?
			fi
			;;
		restart)
			rm -f "$RECORDS.next"
			# Routing survives the stop+start cycle: the diff proved that
			# neither the table id nor the mark changed, so the rules
			# start_service will load again are the same. While the client
			# comes up, marked traffic is held by the blackhole instead of
			# leaking straight.
			_TT_KEEP_ROUTING=1
			restart
			;;
		*)
			rm -f "$RECORDS.next"
			restart
			;;
	esac
}

reload_service() {
	apply_settings
}

service_triggers() {
	procd_add_reload_trigger "trusttunnel"
	procd_add_interface_trigger "interface.*.up" wan /etc/init.d/trusttunnel restart
}

